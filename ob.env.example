# Copy to instance/ob.env (gitignored) and fill in. Read by BOTH the web app and
# manage.py, so the scheduled send-mail / remind-claims tasks get the same settings.
# Anything already set in the real environment (or passenger_wsgi.py) wins.

OB_BASE_URL=https://www.example.com

# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste the 16 letters (spaces are fine).
OB_SMTP_HOST=smtp.gmail.com
OB_SMTP_PORT=587
OB_SMTP_USER=you@gmail.com
OB_SMTP_PASS="abcd efgh ijkl mnop"

# where shana-rishonah leads and contact-form messages go
OB_NOTIFY_EMAIL=you@gmail.com

# optional: the name guests see next to the sender address (default OurBayis)
# OB_MAIL_FROM_NAME=OurBayis
